# Copy to config/.env (hoặc .env ở gốc repo). API nạp hai file này khi khởi động.
# Không commit file .env thật.

# Vector store (Milvus / Zilliz) — chỉ CLI chat --mode rag/hybrid; không dùng cho medical GraphRAG (Neo4j)
STORE_URI=http://localhost:19530
STORE_COLLECTION=chunks
STORE_CONFIG=config/store.json
# Tương thích cũ: MILVUS_URI, MILVUS_COLLECTION, MILVUS_CONFIG
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

USE_OLLAMA=1
# Mặc định: Ollama cài trên cùng máy với uvicorn/python.
OLLAMA_HOST=http://127.0.0.1:11434
# Nếu API chạy trong Docker và Ollama trên máy host (Windows/Mac): OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b

OLLAMA_ROUTER_MODEL=llama3.2:3b

# ==== LỰA CHỌN 2: DÙNG API KEY (OpenRouter / OpenAI) ====
# Nếu không dùng Ollama local, bật API key:
# USE_OLLAMA=0
# LLM_BACKEND=openrouter  # Hoặc: openai

# -- OpenRouter (Free tier available) --
# OPENROUTER_API_KEY=sk-or-v1-xxx
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# -- OpenAI --
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-3.5-turbo

# AGENT_ROUTER_HEURISTICS=0

# Agent: mặc định ReAct. Để dùng lại pipeline router+orchestrator (legacy):
# AGENT_USE_LEGACY_PIPELINE=1
# Hoặc gửi JSON "use_legacy_pipeline": true / "use_react": false
# AGENT_USE_REACT=0 cũng ép legacy.
# AGENT_REACT_MAX_ITER=8
# AGENT_REACT_PARSE_RETRIES=2

# Prompt Ollama (agent, RAG, social): thư mục gốc repo /prompts — tùy chọn ghi đè:
# LLM_APP_PROMPTS_DIR=D:/DATN/prompts

# Neo4j GraphRAG: config/neo4j.json
# Phân tích hồ sơ (medical): GraphRAG luôn gọi sau khi trích văn bản (Ollama + Neo4j).
# MEDICAL_RECORD_GRAPHRAG_TOP_K=6
# Gợi ý phân tích hồ sơ (Ollama) — tăng nếu prompt dài + GraphRAG context lớn
# MEDICAL_RECORD_OLLAMA_TIMEOUT=300

# LLM Reranker: dùng chính LLM để sắp xếp lại các đoạn văn bản (mặc định tắt, dùng RRF siêu tốc)
# KG_USE_LLM_RERANK=0

# Public hardening
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=*
RATE_WINDOW_SEC=60
RATE_MAX_PER_WINDOW=30
