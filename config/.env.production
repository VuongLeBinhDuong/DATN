# =============================================================================
# CẤU HÌNH PRODUCTION - CDSS MEDICAL GRAPHRAG SYSTEM
# Sao chép tệp này thành `config/.env` hoặc `.env` ở thư mục gốc khi chạy production.
# =============================================================================

# ---- 1. Cấu hình Dịch vụ LLM (Ollama hoặc API Key) ----
USE_OLLAMA=1
# Đường dẫn kết nối Ollama nội bộ trong Docker network (container name: ollama)
OLLAMA_HOST=http://ollama:11434
# Mô hình khuyên dùng cho chẩn đoán CDSS và xử lý tri thức y tế
OLLAMA_MODEL=llama3.1:8b
OLLAMA_ROUTER_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=300

# Nếu chuyển sang dùng OpenRouter ở production, bỏ comment các dòng dưới và đặt USE_OLLAMA=0
# USE_OLLAMA=0
# LLM_BACKEND=openrouter
# OPENROUTER_API_KEY=sk-or-v1-xxx
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ---- 2. Cấu hình Cơ sở dữ liệu Đồ thị Neo4j ----
NEO4J_ENABLED=true
# Đường dẫn kết nối Neo4j nội bộ trong Docker network (container name: neo4j)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# ---- 3. Cấu hình Hiệu năng Máy chủ (FastAPI & Uvicorn) ----
# Số lượng workers xử lý song song trên production (tương đương số nhân CPU)
WEB_CONCURRENCY=4

# Chế độ theo dõi vết tác nhân (Tắt ở production để tránh log quá tải và lộ dữ liệu)
AGENT_TRACE=false

# LLM Reranker: dùng chính LLM để sắp xếp lại các đoạn văn bản (mặc định tắt, dùng RRF siêu tốc)
KG_USE_LLM_RERANK=0

# ---- 4. Bảo mật & Chống tấn công (Public Hardening) ----
# Danh sách các domain được phép gọi API (Ví dụ: https://cdss.yourdomain.com)
# Thay đổi thành tên miền thực tế của bạn thay vì dấu * để tăng bảo mật.
CORS_ORIGINS=*

# Cấu hình giới hạn tần suất gọi API (Rate Limiting)
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_MAX_PER_WINDOW=100
